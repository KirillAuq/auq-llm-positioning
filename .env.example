# Provider keys. Set these in Vercel → Project → Settings → Environment Variables,
# or locally in .env.local. Keys entered on the Settings page override these per browser.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPINFRA_API_KEY=

# Optional but recommended on a public deployment: when set, every API route
# requires this password (entered once on the Settings page).
APP_PASSWORD=
