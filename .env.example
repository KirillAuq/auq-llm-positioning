# Set these in Vercel → Project → Settings → Environment Variables, or locally in .env.local.

# --- Accounts and saved data (Supabase) ---
# From the Supabase project: Settings → API Keys (and the project URL).
# Without these the app still runs audits, but with no logins, saved settings, team reports or leads.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Secret. Server-side only; never expose it to the browser.
SUPABASE_SECRET_KEY=
# The email of the account that is the admin. Create that user in Supabase
# (Authentication → Users → Add user), then log in with it. Comma-separate several.
ADMIN_EMAIL=

# --- Provider keys (optional fallback) ---
# The admin normally saves these on the Settings page. A key set here is used
# when none has been saved there.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPINFRA_API_KEY=
